# CampusCycle environment configuration
#
# Copy this file to .env and fill in the values for your own Supabase project.
# .env is gitignored. Never commit real keys, passwords, or service-role tokens.

# ---------------------------------------------------------------------------
# Supabase project
# ---------------------------------------------------------------------------
# Project URL and publishable key, both safe to expose in a desktop client.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Service-role key. Needed by the app itself for two things: creating a Supabase
# Auth identity when a student registers, and creating ADMIN/TECHNICIAN accounts.
# This key bypasses row-level security, so treat it as a server secret: keep it in
# .env, restrict it to the project it belongs to, and rotate it if it is ever
# exposed. It is not a "publishable" key.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Direct database connection
# ---------------------------------------------------------------------------
# Use the pooled connection string from Supabase (Dashboard > Connect).
# Prefer the least-privilege app role created by
# supabase/migrations/202609270003_app_role_and_policies.sql over the
# postgres superuser; rotate the superuser password if it has ever been shared.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# FreeRoute key, used to draw cycling routes between campus hubs. The app runs
# without it; routing is simply unavailable.
FREEROUTE_API_KEY=
